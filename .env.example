# eBay Finding API — App ID (Client ID) only, no OAuth required for GET
# Get yours free at https://developer.ebay.com (see README)
EBAY_APP_ID=YourApp-XXXX-XXXX-XXXX
EBAY_CLIENT_SECRET=

# Apify API token — powers the GovDeals source (free tier: 100 items/run)
# Get yours at https://apify.com → Settings → Integrations → API token
APIFY_API_KEY=

# Local-only (Vercel sets these automatically in production)
PORT=3001
NODE_ENV=development
